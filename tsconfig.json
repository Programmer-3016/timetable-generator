{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["jest"]
  },
  "include": ["src/js/**/*.js", "src/js/globals.d.ts"],
  "exclude": ["node_modules", "dist"]
}
